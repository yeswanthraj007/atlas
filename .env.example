# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Get paper-trading keys from the Alpaca dashboard (Paper Trading > API Keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Keep true until a strategy has passed backtesting AND a paper-trading period.
ALPACA_PAPER=true
# Live quotes: iex = free plan (IEX exchange only), sip = paid consolidated tape.
ALPACA_DATA_FEED=iex
# Historical bars: sip works on the free plan for data older than 15 minutes.
ALPACA_HISTORICAL_FEED=sip
ATLAS_DATA_DIR=data
# SEC EDGAR fair-access policy: "Your Name your@email.com"
SEC_USER_AGENT=
